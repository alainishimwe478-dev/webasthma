# Vite Environment Variables (restart dev server after changes)
# Get free OpenWeatherMap API key: https://openweathermap.org/api

VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Backend URL (if using custom backend)
VITE_BACKEND_URL=http://localhost:5000

# Optional: OpenAI for chatbot (if needed)
VITE_OPENAI_API_KEY=sk-...
